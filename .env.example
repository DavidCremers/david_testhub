# Aedes Carrière Nieuws Monitor - Environment Variables
# ======================================================
# Kopieer dit bestand naar .env en vul je gegevens in:
#   cp .env.example .env
#   nano .env
#
# Start daarna met: docker-compose up -d

# SMTP Server configuratie
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=jouw.email@gmail.com
SMTP_PASSWORD=jouw-app-wachtwoord

# Afzender
SENDER_EMAIL=jouw.email@gmail.com
SENDER_NAME=Aedes Carrière Nieuws Monitor

# Ontvangers (comma-separated voor meerdere adressen)
RECIPIENTS=ontvanger1@example.com,ontvanger2@example.com,team@example.com

# Optioneel: check interval in minuten (standaard 1440 = 24 uur)
CHECK_INTERVAL_MINUTES=1440

# Gmail specifieke instructies:
# -----------------------------
# 1. Ga naar https://myaccount.google.com/security
# 2. Schakel 2-factor authenticatie in
# 3. Ga naar "App-wachtwoorden"
# 4. Maak een nieuw app-wachtwoord voor "Mail"
# 5. Gebruik dit wachtwoord als SMTP_PASSWORD

# Office 365 / Outlook:
# ---------------------
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
