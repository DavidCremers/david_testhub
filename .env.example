# Aedes Carrière Nieuws Monitor - Environment Variables
# ======================================================
# Kopieer dit bestand naar .env en vul je gegevens in:
#   cp .env.example .env
#   nano .env

# =====================================================
# KIES JE EMAIL PROVIDER
# =====================================================
# Opties: "sendgrid", "mailgun", of "smtp"
EMAIL_PROVIDER=sendgrid

# =====================================================
# OPTIE 1: SendGrid (AANBEVOLEN - gratis 100 emails/dag)
# =====================================================
# 1. Ga naar https://sendgrid.com → gratis account aanmaken
# 2. Settings → API Keys → Create API Key
# 3. Kopieer de key hieronder

EMAIL_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=nieuws@jouwdomein.nl
SENDER_NAME=Aedes Carrière Nieuws

# =====================================================
# OPTIE 2: Mailgun
# =====================================================
# EMAIL_PROVIDER=mailgun
# EMAIL_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.jouwdomein.nl
# SENDER_EMAIL=nieuws@mg.jouwdomein.nl
# SENDER_NAME=Aedes Carrière Nieuws

# =====================================================
# OPTIE 3: SMTP (Gmail, Outlook)
# =====================================================
# EMAIL_PROVIDER=smtp
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=jouw.email@gmail.com
# SMTP_PASSWORD=jouw-app-wachtwoord
# SENDER_EMAIL=jouw.email@gmail.com
# SENDER_NAME=Aedes Carrière Nieuws

# =====================================================
# ONTVANGERS
# =====================================================
# Comma-separated lijst van email adressen
RECIPIENTS=ontvanger1@example.com,ontvanger2@example.com

# =====================================================
# OVERIGE INSTELLINGEN
# =====================================================
# Check interval in minuten (1440 = 24 uur)
CHECK_INTERVAL_MINUTES=1440
LOG_LEVEL=INFO
