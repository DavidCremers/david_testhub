[Unit]
Description=Check Aedes Carrière Nieuws elk uur
Documentation=https://github.com/finance-ideas/mjob-analyse

[Timer]
# Elke 60 minuten uitvoeren
OnBootSec=5min
OnUnitActiveSec=60min

# Willekeurige vertraging om server load te spreiden
RandomizedDelaySec=5min

# Persistent: voer gemiste runs uit na reboot
Persistent=true

[Install]
WantedBy=timers.target
