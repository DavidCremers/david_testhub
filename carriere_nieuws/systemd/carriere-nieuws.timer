[Unit]
Description=Check Aedes Carrière Nieuws dagelijks
Documentation=https://github.com/finance-ideas/mjob-analyse

[Timer]
# Elke 24 uur uitvoeren
OnBootSec=5min
OnUnitActiveSec=24h

# Willekeurige vertraging om server load te spreiden
RandomizedDelaySec=30min

# Persistent: voer gemiste runs uit na reboot
Persistent=true

[Install]
WantedBy=timers.target
